{
	"name": "codenames",
	"type": "module",
	"version": "1.1.0",
	"private": true,
	"license": "MIT",
	"engines": {
		"node": "26.11.1"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"relay": "node --watch src/backend/server.ts",
		"check": "astro check && svelte-check",
		"test": "node --test 'src/**/*.test.ts'",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"astro": "astro",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint:css": "stylelint \"src/**/*.{css,astro,svelte}\"",
		"lint:js": "oxlint --deny-warnings",
		"release": "release-it",
		"prepare": "husky",
		"commit": "cz"
	},
	"dependencies": {
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/svelte": "9.0.1",
		"@fontsource-variable/manrope": "5.3.0",
		"@lucide/svelte": "1.55.0",
		"@zxing/browser": "0.2.0",
		"@zxing/library": "0.22.0",
		"astro": "7.3.7",
		"idb-keyval": "6.2.5",
		"pako": "2.1.0",
		"qrcode": "1.5.4",
		"svelte": "5.57.2",
		"svelte-sonner": "1.2.1",
		"ws": "8.22.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@commitlint/cli": "21.0.2",
		"@commitlint/config-conventional": "21.0.2",
		"@csstools/postcss-global-data": "4.0.0",
		"@ianvs/prettier-plugin-sort-imports": "4.7.1",
		"@playwright/test": "1.64.0",
		"@release-it/conventional-changelog": "11.0.1",
		"@types/node": "26.6.5",
		"@types/pako": "2.0.4",
		"@types/qrcode": "1.5.6",
		"@types/ws": "8.18.2",
		"@vitejs/plugin-basic-ssl": "2.3.0",
		"commitizen": "4.3.2",
		"cz-git": "1.13.1",
		"husky": "9.1.7",
		"oxlint": "1.87.0",
		"postcss-custom-media": "12.0.3",
		"postcss-html": "2.0.0",
		"postcss-nested": "8.0.1",
		"prettier": "3.9.9",
		"prettier-plugin-astro": "1.1.0",
		"prettier-plugin-svelte": "4.1.1",
		"release-it": "20.2.0",
		"stylelint": "17.16.0",
		"stylelint-config-clean-order": "10.0.0",
		"stylelint-order": "8.1.1",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"workbox-build": "7.4.1"
	},
	"imports": {
		"#frontend/*": "./src/frontend/*",
		"#backend/*": "./src/backend/*",
		"#shared/*": "./src/shared/*"
	},
	"config": {
		"commitizen": {
			"path": "node_modules/cz-git"
		}
	}
}
