---
import '@fontsource-variable/manrope'
import '#frontend/styles/global.css'
import { site } from '#frontend/data/site.ts'
import { pageTitle } from '#frontend/lib/title.ts'

type Props = {
	/** Page title; the site name gets appended. Not set on the home page. */
	title?: string
	/** `meta description` and `og:description`, defaults to `site.description`. */
	description?: string
	/** `false` for service pages like 404: no canonical, and indexing is disallowed. */
	index?: boolean
}

const { title, description = site.description, index = true } = Astro.props
const fullTitle = pageTitle(title)
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
		/>
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{index ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content="ru_RU" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta name="theme-color" content="#0f172a" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content={site.name} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<!-- Theme before the bundle loads: the startup loader and first frame don't flash white in dark theme.
		     applyTheme() in state/theme.ts repeats the same logic. -->
		<script is:inline>
			try {
				const t = localStorage.getItem('codenames.theme')
				const dark =
					t === 'dark' || ((t === 'system' || !t) && matchMedia('(prefers-color-scheme: dark)').matches)
				if (dark) document.documentElement.classList.add('dark')
			} catch {}
		</script>
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>
