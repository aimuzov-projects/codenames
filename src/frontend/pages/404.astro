---
import NotFound from '@aimuzov/infra-site-kit/not-found.astro'
import Base from '#frontend/layouts/base.astro'
---

<Base title="Страница не найдена" description="Такой страницы на сайте нет." index={false}>
	<main class="missing">
		<NotFound />
	</main>
</Base>

<style>
	/* Документ у игры не скроллится (global.css), поэтому прокрутка -- у самой страницы. */
	.missing {
		--not-found-accent: var(--primary);
		--not-found-muted: var(--muted-foreground);
		--not-found-radius: var(--radius-lg);
		user-select: text;
		overflow-y: auto;

		display: grid;
		align-items: center;
		height: 100%;
		padding: var(--safe-top) 0 var(--safe-bottom);
	}
</style>
